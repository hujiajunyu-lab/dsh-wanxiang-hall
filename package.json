{
  "name": "dsh-wanxiang-hall",
  "version": "2.3.0",
  "type": "module",
  "description": "Delivery org for DeepSeek Harness: intake, architect, review, dispatch, build, accept — three staffing shapes, 33 tools, hard gates, heartbeat from session logs, and a cross-project knowledge base. 万象工阁。",
  "license": "MIT",
  "author": "幻盏 / 衍露 (Huanzhan Yanlu)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-orchestration",
    "multi-agent",
    "workflow",
    "code-review",
    "solo-company"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "activity.js",
    "context.js",
    "ownership.js",
    "packages.js",
    "fork.js",
    "brand.js",
    "kb.js",
    "tools.js",
    "client.js",
    "handoff.js",
    "sessions.js",
    "snapshot.js",
    "vault.js",
    "auth.js",
    "checks.js",
    "diff.js",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "README.zh.md",
    "CHANGELOG.md",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hujiajunyu-lab/dsh-wanxiang-hall.git"
  },
  "bugs": {
    "url": "https://github.com/hujiajunyu-lab/dsh-wanxiang-hall/issues"
  },
  "homepage": "https://github.com/hujiajunyu-lab/dsh-wanxiang-hall#readme",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/court.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
